{
  "manifest_version": 3,
  "name": "Typing Auto Spell Correcter",
  "description": "Corrects common spelling mistakes while you type across web pages.",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "no-sign-16.png",
    "32": "no-sign-32.png",
    "48": "no-sign-48.png",
    "128": "no-sign-128.png"
  },
  "action": {
    "default_title": "Spell Correcter",
    "default_icon": {
      "16": "no-sign-16.png",
      "32": "no-sign-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ad-blocker.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["english-words.txt"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
